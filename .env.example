# ─────────────────────────────────────────────
# InviteAI — Environment Variables
# Copy this file to .env.local for local dev
# Add these in Vercel Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────

# Razorpay Keys (get from https://dashboard.razorpay.com/app/website-app-settings/api-keys)
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX

# Your deployed frontend URL (update after first Vercel deploy)
# Example: https://inviteai.vercel.app  OR  https://inviteai.in
FRONTEND_URL=https://inviteai.vercel.app
